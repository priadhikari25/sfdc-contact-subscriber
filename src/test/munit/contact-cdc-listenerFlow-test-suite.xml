    <munit:test
        name="testSalesforceQueryFailure"
        description="Validate Salesforce enrichment query error handling"
        expectedErrorType="MULE:RETRY_EXHAUSTED">

        <munit:behavior>

            <munit-tools:mock-when processor="salesforce:query">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="#['Retrieve Salesforce Contact Details']"/>
                </munit-tools:with-attributes>

                <munit-tools:then-return>
                    <munit-tools:error
                        typeId="SALESFORCE:CONNECTIVITY"/>
                </munit-tools:then-return>

            </munit-tools:mock-when>

        </munit:behavior>

        <munit:execution>

            <munit:set-event doc:name="Set Query Failure Context">

                <munit:payload
                    value="#[null]"
                    mediaType="application/java"/>

                <munit:variables>

                    <munit:variable
                        key="correlationId"
                        value="#['TEST-CORRELATION-FAILURE']"/>

                    <munit:variable
                        key="contactId"
                        value="#['003QUERYFAIL']"/>

                    <munit:variable
                        key="replayId"
                        value="#[2126899]"/>

                    <munit:variable
                        key="changeType"
                        value="#['UPDATE']"/>

                </munit:variables>

            </munit:set-event>

            <flow-ref
                name="contact-contact-detail-enrichment-subflow"
                doc:name="Execute Contact Enrichment Failure Flow"/>

        </munit:execution>

    </munit:test>

    <munit:test
        name="testAmqpMessagePublisher"
        description="Verify enriched Contact message is published to RabbitMQ">

        <munit:behavior>

            <munit-tools:mock-when
                processor="amqp:publish"
                doc:name="Mock RabbitMQ Publication">

                <munit-tools:then-return>
                    <munit-tools:payload
                        value="#[payload]"
                        mediaType="application/java"/>
                </munit-tools:then-return>

            </munit-tools:mock-when>

        </munit:behavior>

        <munit:execution>

            <munit:set-event doc:name="Set AMQP Publication Context">

                <munit:payload
                    value="#[null]"
                    mediaType="application/java"/>

                <munit:variables>

                    <munit:variable
                        key="correlationId"
                        value="#['TEST-CORRELATION-AMQP-001']"/>

                    <munit:variable
                        key="contactId"
                        value="#['003AMQPPUBLISH']"/>

                    <munit:variable
                        key="changeType"
                        value="#['UPDATE']"/>

                    <munit:variable
                        key="replayId"
                        value="#[2126833]"/>

                    <munit:variable
                        key="jmsPayload"
                        mediaType="application/java"
                        value='#[{
                            contact_sf_id: "003AMQPPUBLISH",
                            first_name: "Priya",
                            last_name: "Adhikari",
                            email: "priya.adhikari@test.com",
                            phone: "9876543210",
                            account_id: "001AMQPPUBLISH",
                            job_title: "Technical Trainee",
                            department: "Technology",
                            reports_to_id: null,
                            reports_to_name: "Unassigned",
                            account_name: "Microsoft",
                            account_industry: "Technology",
                            account_type: "Customer - Direct",
                            account_revenue: 15000000,
                            account_contact_count: 4,
                            contact_priority: "HIGH",
                            modified_date: "2026-10-09 20:15:35"
                        }]'/>

                </munit:variables>

            </munit:set-event>

            <flow-ref
                name="contact-jms-message-publisher-subflow"
                doc:name="Execute RabbitMQ Publisher Subflow"/>

        </munit:execution>

        <munit:validation>

            <munit-tools:verify-call
                processor="amqp:publish"
                times="1"
                doc:name="Verify RabbitMQ Message Published"/>

            <munit-tools:assert-that
                expression="#[vars.correlationId]"
                is="#[MunitTools::equalTo('TEST-CORRELATION-AMQP-001')]"
                message="AMQP correlation ID was not preserved."/>

            <munit-tools:assert-that
                expression="#[vars.jmsPayload.contact_sf_id]"
                is="#[MunitTools::equalTo('003AMQPPUBLISH')]"
