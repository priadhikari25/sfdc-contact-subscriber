<?xml version="1.0" encoding="UTF-8"?>

<mule
    xmlns="http://www.mulesoft.org/schema/mule/core"
    xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
    xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
    xmlns:salesforce="http://www.mulesoft.org/schema/mule/salesforce"
    xmlns:amqp="http://www.mulesoft.org/schema/mule/amqp"
    xsi:schemaLocation="
http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd 
        http://www.mulesoft.org/schema/mule/core
        http://www.mulesoft.org/schema/mule/core/current/mule.xsd

        http://www.mulesoft.org/schema/mule/munit
        http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd

        http://www.mulesoft.org/schema/mule/munit-tools
        http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd

        http://www.mulesoft.org/schema/mule/salesforce
        http://www.mulesoft.org/schema/mule/salesforce/current/mule-salesforce.xsd

        http://www.mulesoft.org/schema/mule/amqp
        http://www.mulesoft.org/schema/mule/amqp/current/mule-amqp.xsd">

    <munit:config name="munit"/>

    <munit:test
        name="testContactEnrichment"
        description="Validate Account, Reports To, and Account Contact Count enrichment">

        <munit:behavior>

            <munit-tools:mock-when processor="salesforce:query">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="#['Retrieve Salesforce Contact Details']"/>
                </munit-tools:with-attributes>

                <munit-tools:then-return>
                    <munit-tools:payload
                        mediaType="application/java"
                        value='#[[
                            {
                                Id: "003TEST",
                                FirstName: "Arjun",
                                LastName: "Metha",
                                Email: "ARJUN.METHA@TEST.COM",
                                Phone: "9876543210",
                                AccountId: "001TEST",
                                Title: "Engineering Manager",
                                Department: "Engineering",
                                ReportsToId: "003MGR",
                                LastModifiedDate:
                                    "2026-10-08T20:23:12.000Z"
                            }
                        ]]'/>
                </munit-tools:then-return>

            </munit-tools:mock-when>

            <munit-tools:mock-when processor="salesforce:query">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="#['Retrieve Related Account Details']"/>
                </munit-tools:with-attributes>

                <munit-tools:then-return>
                    <munit-tools:payload
                        mediaType="application/java"
                        value='#[[
                            {
                                Id: "001TEST",
                                Name: "Microsoft",
                                Industry: "Technology",
                                Type: "Customer - Direct",
                                AnnualRevenue: 15000000
                            }
                        ]]'/>
                </munit-tools:then-return>

            </munit-tools:mock-when>

            <munit-tools:mock-when processor="salesforce:query">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="#['Retrieve Reports To Contact Details']"/>
                </munit-tools:with-attributes>

                <munit-tools:then-return>
                    <munit-tools:payload
                        mediaType="application/java"
                        value='#[[
                            {
                                Id: "003MGR",
                                Name: "John Manager"
                            }
                        ]]'/>
                </munit-tools:then-return>

            </munit-tools:mock-when>

            <munit-tools:mock-when processor="salesforce:query">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="#['Retrieve Related Account Contact Count']"/>
                </munit-tools:with-attributes>

                <munit-tools:then-return>
                    <munit-tools:payload
                        mediaType="application/java"
                        value='#[[
                            {Id: "003CONTACT1"},
                            {Id: "003CONTACT2"},
                            {Id: "003CONTACT3"},
                            {Id: "003CONTACT4"}
                        ]]'/>
                </munit-tools:then-return>

            </munit-tools:mock-when>

            <munit-tools:mock-when processor="flow-ref">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="name"
                        whereValue="#['contact-jms-message-publisher-subflow']"/>
                </munit-tools:with-attributes>

                <munit-tools:then-return>
                    <munit-tools:payload
                        value="#[payload]"
                        mediaType="application/java"/>
                </munit-tools:then-return>

            </munit-tools:mock-when>

        </munit:behavior>

        <munit:execution>

            <munit:set-event doc:name="Set Contact CDC Event">

                <munit:payload
                    mediaType="application/java"
                    value='#[{
                        data: {
                            schema: "TEST_SCHEMA",
                            payload: {
                                ChangeEventHeader: {
                                    entityName: "Contact",
                                    changeType: "UPDATE",
                                    recordIds: ["003TEST"]
                                }
                            },
                            event: {
                                replayId: 2126833
                            }
                        },
                        channel: "/data/ContactChangeEvent"
                    }]'/>

            </munit:set-event>

            <flow-ref
                name="contact-cdc-listenerFlow"
                doc:name="Execute Contact CDC Listener Flow"/>

        </munit:execution>

        <munit:validation>

            <munit-tools:assert-that
                expression="#[vars.contactDetails.Id]"
                is="#[MunitTools::equalTo('003TEST')]"
                message="Contact ID was not populated correctly."/>

            <munit-tools:assert-that
                expression="#[vars.accountDetails.Name]"
                is="#[MunitTools::equalTo('Microsoft')]"
                message="Account Name was not enriched correctly."/>

            <munit-tools:assert-that
                expression="#[vars.accountDetails.Industry]"
                is="#[MunitTools::equalTo('Technology')]"
                message="Account Industry was not enriched correctly."/>

            <munit-tools:assert-that
                expression="#[vars.accountDetails.Type]"
                is="#[MunitTools::equalTo('Customer - Direct')]"
                message="Account Type was not enriched correctly."/>

            <munit-tools:assert-that
                expression="#[vars.accountDetails.AnnualRevenue]"
                is="#[MunitTools::equalTo(15000000)]"
                message="Account Annual Revenue was not enriched correctly."/>

            <munit-tools:assert-that
                expression="#[vars.managerDetails.Name]"
                is="#[MunitTools::equalTo('John Manager')]"
                message="Reports To name was not enriched correctly."/>

            <munit-tools:assert-that
                expression="#[vars.accountContactCount]"
                is="#[MunitTools::equalTo(4)]"
                message="Account Contact Count was not populated correctly."/>

            <munit-tools:verify-call
                processor="salesforce:query"
                times="1">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="#['Retrieve Salesforce Contact Details']"/>
                </munit-tools:with-attributes>

            </munit-tools:verify-call>

            <munit-tools:verify-call
                processor="salesforce:query"
                times="1">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="#['Retrieve Related Account Details']"/>
                </munit-tools:with-attributes>

            </munit-tools:verify-call>

            <munit-tools:verify-call
                processor="salesforce:query"
                times="1">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="#['Retrieve Reports To Contact Details']"/>
                </munit-tools:with-attributes>

            </munit-tools:verify-call>

            <munit-tools:verify-call
                processor="salesforce:query"
                times="1">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="#['Retrieve Related Account Contact Count']"/>
                </munit-tools:with-attributes>

            </munit-tools:verify-call>

            <munit-tools:verify-call
                processor="flow-ref"
                times="1">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="name"
                        whereValue="#['contact-jms-message-publisher-subflow']"/>
                </munit-tools:with-attributes>

            </munit-tools:verify-call>

        </munit:validation>

    </munit:test>

    <munit:test
        name="testHighPriorityContact"
        description="Validate HIGH priority for revenue greater than 10000000">

        <munit:execution>

            <munit:set-event doc:name="Set High Revenue Account">

                <munit:payload
                    value="#[null]"
                    mediaType="application/java"/>

                <munit:variables>

                    <munit:variable
                        key="contactId"
                        value="#['003HIGH']"/>

                    <munit:variable
                        key="replayId"
                        value="#[101]"/>

                    <munit:variable
                        key="changeType"
                        value="#['UPDATE']"/>

                    <munit:variable
                        key="accountDetails"
                        mediaType="application/java"
                        value='#[{
                            Name: "High Revenue Account",
                            Industry: "Technology",
                            Type: "Prospect",
                            AnnualRevenue: 15000000
                        }]'/>

                </munit:variables>

            </munit:set-event>

            <flow-ref
                name="contact-priority-calculation-subflow"
                doc:name="Execute High Priority Calculation"/>

        </munit:execution>

        <munit:validation>

            <munit-tools:assert-that
                expression="#[vars.contactPriority]"
                is="#[MunitTools::equalTo('HIGH')]"
                message="Priority must be HIGH."/>

        </munit:validation>

    </munit:test>

    <munit:test
        name="testCustomerPriority"
        description="Validate MEDIUM priority for Customer below HIGH threshold">

        <munit:execution>

            <munit:set-event doc:name="Set Customer Account">

                <munit:payload
                    value="#[null]"
                    mediaType="application/java"/>

                <munit:variables>

                    <munit:variable
                        key="contactId"
                        value="#['003MEDIUM']"/>

                    <munit:variable
                        key="replayId"
                        value="#[102]"/>

                    <munit:variable
                        key="changeType"
                        value="#['UPDATE']"/>

                    <munit:variable
                        key="accountDetails"
                        mediaType="application/java"
                        value='#[{
                            Name: "Customer Account",
                            Industry: "Consulting",
                            Type: "Customer",
                            AnnualRevenue: 8000000
                        }]'/>

                </munit:variables>

            </munit:set-event>

            <flow-ref
                name="contact-priority-calculation-subflow"
                doc:name="Execute Customer Priority Calculation"/>

        </munit:execution>

        <munit:validation>

            <munit-tools:assert-that
                expression="#[vars.contactPriority]"
                is="#[MunitTools::equalTo('MEDIUM')]"
                message="Priority must be MEDIUM."/>

        </munit:validation>

    </munit:test>

    <munit:test
        name="testDefaultPriority"
        description="Validate NORMAL priority for all other Contacts">

        <munit:execution>

            <munit:set-event doc:name="Set Prospect Account">

                <munit:payload
                    value="#[null]"
                    mediaType="application/java"/>

                <munit:variables>

                    <munit:variable
                        key="contactId"
                        value="#['003NORMAL']"/>

                    <munit:variable
                        key="replayId"
                        value="#[103]"/>

                    <munit:variable
                        key="changeType"
                        value="#['UPDATE']"/>

                    <munit:variable
                        key="accountDetails"
                        mediaType="application/java"
                        value='#[{
                            Name: "Prospect Account",
                            Industry: "Education",
                            Type: "Prospect",
                            AnnualRevenue: 5000000
                        }]'/>

                </munit:variables>

            </munit:set-event>

            <flow-ref
                name="contact-priority-calculation-subflow"
                doc:name="Execute Default Priority Calculation"/>

        </munit:execution>

        <munit:validation>

            <munit-tools:assert-that
                expression="#[vars.contactPriority]"
                is="#[MunitTools::equalTo('NORMAL')]"
                message="Priority must be NORMAL."/>

        </munit:validation>

    </munit:test>

    <munit:test
        name="testTransformationOutput"
        description="Validate Contact onboarding payload transformation">

        <munit:execution>

            <munit:set-event doc:name="Set Enriched Contact Variables">

                <munit:payload
                    value="#[null]"
                    mediaType="application/java"/>

                <munit:variables>

                    <munit:variable
                        key="correlationId"
                        value="#['TEST-CORRELATION-001']"/>

                    <munit:variable
                        key="contactId"
                        value="#['003TRANSFORM']"/>

                    <munit:variable
                        key="accountId"
                        value="#['001TRANSFORM']"/>

                    <munit:variable
                        key="reportsToId"
                        value="#['003MANAGER']"/>

                    <munit:variable
                        key="replayId"
                        value="#[2126833]"/>

                    <munit:variable
                        key="changeType"
                        value="#['UPDATE']"/>

                    <munit:variable
                        key="contactDetails"
                        mediaType="application/java"
                        value='#[{
                            Id: "003TRANSFORM",
                            FirstName: "Priya",
                            LastName: "Adhikari",
                            Email: "PRIYA.ADHIKARI@TEST.COM",
                            Phone: "9876543210",
                            AccountId: "001TRANSFORM",
                            Title: "Technical Trainee",
                            Department: "Technology",
                            ReportsToId: "003MANAGER",
                            LastModifiedDate:
                                "2026-10-08T20:23:12.000Z"
                        }]'/>

                    <munit:variable
                        key="accountDetails"
                        mediaType="application/java"
                        value='#[{
                            Id: "001TRANSFORM",
                            Name: "Microsoft",
                            Industry: "Technology",
                            Type: "Customer - Direct",
                            AnnualRevenue: 15000000
                        }]'/>

                    <munit:variable
                        key="managerDetails"
                        mediaType="application/java"
                        value='#[{
                            Id: "003MANAGER",
                            Name: "John Manager"
                        }]'/>

                    <munit:variable
                        key="accountContactCount"
                        value="#[4]"/>

                    <munit:variable
                        key="contactPriority"
                        value="#['HIGH']"/>

                </munit:variables>

            </munit:set-event>

            <flow-ref
                name="contact-jms-payload-builder-subflow"
                doc:name="Execute Onboarding Payload Transformation"/>

        </munit:execution>

        <munit:validation>

            <munit-tools:assert-that
                expression="#[vars.jmsPayload]"
                is="#[MunitTools::notNullValue()]"
                message="Onboarding payload was not created."/>

            <munit-tools:assert-that
                expression="#[vars.jmsPayload.contact_sf_id]"
                is="#[MunitTools::equalTo('003TRANSFORM')]"
                message="Contact ID mapping is incorrect."/>

            <munit-tools:assert-that
                expression="#[vars.jmsPayload.first_name]"
                is="#[MunitTools::equalTo('Priya')]"
                message="First Name mapping is incorrect."/>

            <munit-tools:assert-that
                expression="#[vars.jmsPayload.last_name]"
                is="#[MunitTools::equalTo('Adhikari')]"
                message="Last Name mapping is incorrect."/>

            <munit-tools:assert-that
                expression="#[vars.jmsPayload.email]"
                is="#[MunitTools::equalTo('priya.adhikari@test.com')]"
                message="Email was not converted to lowercase."/>

            <munit-tools:assert-that
                expression="#[vars.jmsPayload.account_name]"
                is="#[MunitTools::equalTo('Microsoft')]"
                message="Account Name enrichment is incorrect."/>

            <munit-tools:assert-that
                expression="#[vars.jmsPayload.reports_to_name]"
                is="#[MunitTools::equalTo('John Manager')]"
                message="Reports To Name enrichment is incorrect."/>

            <munit-tools:assert-that
                expression="#[vars.jmsPayload.account_contact_count]"
                is="#[MunitTools::equalTo(4)]"
                message="Account Contact Count is incorrect."/>

            <munit-tools:assert-that
                expression="#[vars.jmsPayload.contact_priority]"
                is="#[MunitTools::equalTo('HIGH')]"
                message="Contact Priority is incorrect."/>

            <munit-tools:assert-that
                expression="#[vars.jmsPayload.modified_date]"
                is="#[MunitTools::equalTo('2026-10-08 20:23:12')]"
                message="Modified Date formatting is incorrect."/>

        </munit:validation>

    </munit:test>

    <munit:test
        name="testSalesforceQueryFailure"
        description="Validate Salesforce enrichment query error handling"
        expectedErrorType="MULE:RETRY_EXHAUSTED">

        <munit:behavior>

            <munit-tools:mock-when processor="salesforce:query">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="#['Retrieve Salesforce Contact Details']"/>
                </munit-tools:with-attributes>

                <munit-tools:then-return>
                    <munit-tools:error
                        typeId="SALESFORCE:CONNECTIVITY"/>
                </munit-tools:then-return>

            </munit-tools:mock-when>

        </munit:behavior>

        <munit:execution>

            <munit:set-event doc:name="Set Query Failure Context">

                <munit:payload
                    value="#[null]"
                    mediaType="application/java"/>

                <munit:variables>

                    <munit:variable
                        key="correlationId"
                        value="#['TEST-CORRELATION-FAILURE']"/>

                    <munit:variable
                        key="contactId"
                        value="#['003QUERYFAIL']"/>

                    <munit:variable
                        key="replayId"
                        value="#[2126899]"/>

                    <munit:variable
                        key="changeType"
                        value="#['UPDATE']"/>

                </munit:variables>

            </munit:set-event>

            <flow-ref
                name="contact-contact-detail-enrichment-subflow"
                doc:name="Execute Contact Enrichment Failure Flow"/>

        </munit:execution>

    </munit:test>

    <munit:test
        name="testAmqpMessagePublisher"
        description="Verify enriched Contact message is published to RabbitMQ">

        <munit:behavior>

            <munit-tools:mock-when
                processor="amqp:publish"
                doc:name="Mock RabbitMQ Publication">

                <munit-tools:then-return>
                    <munit-tools:payload
                        value="#[payload]"
                        mediaType="application/java"/>
                </munit-tools:then-return>

            </munit-tools:mock-when>

        </munit:behavior>

        <munit:execution>

            <munit:set-event doc:name="Set AMQP Publication Context">

                <munit:payload
                    value="#[null]"
                    mediaType="application/java"/>

                <munit:variables>

                    <munit:variable
                        key="correlationId"
                        value="#['TEST-CORRELATION-AMQP-001']"/>

                    <munit:variable
                        key="contactId"
                        value="#['003AMQPPUBLISH']"/>

                    <munit:variable
                        key="changeType"
                        value="#['UPDATE']"/>

                    <munit:variable
                        key="replayId"
                        value="#[2126833]"/>

                    <munit:variable
                        key="jmsPayload"
                        mediaType="application/java"
                        value='#[{
                            contact_sf_id: "003AMQPPUBLISH",
                            first_name: "Priya",
                            last_name: "Adhikari",
                            email: "priya.adhikari@test.com",
                            phone: "9876543210",
                            account_id: "001AMQPPUBLISH",
                            job_title: "Technical Trainee",
                            department: "Technology",
                            reports_to_id: null,
                            reports_to_name: "Unassigned",
                            account_name: "Microsoft",
                            account_industry: "Technology",
                            account_type: "Customer - Direct",
                            account_revenue: 15000000,
                            account_contact_count: 4,
                            contact_priority: "HIGH",
                            modified_date: "2026-10-09 20:15:35"
                        }]'/>

                </munit:variables>

            </munit:set-event>

            <flow-ref
                name="contact-jms-message-publisher-subflow"
                doc:name="Execute RabbitMQ Publisher Subflow"/>

        </munit:execution>

        <munit:validation>

            <munit-tools:verify-call
                processor="amqp:publish"
                times="1"
                doc:name="Verify RabbitMQ Message Published"/>

            <munit-tools:assert-that
                expression="#[vars.correlationId]"
                is="#[MunitTools::equalTo('TEST-CORRELATION-AMQP-001')]"
                message="AMQP correlation ID was not preserved."/>

            <munit-tools:assert-that
                expression="#[vars.jmsPayload.contact_sf_id]"
                is="#[MunitTools::equalTo('003AMQPPUBLISH')]"
                message="AMQP Contact ID was not preserved."/>

            <munit-tools:assert-that
                expression="#[vars.changeType]"
                is="#[MunitTools::equalTo('UPDATE')]"
                message="AMQP event type was not preserved."/>

            <munit-tools:assert-that
                expression="#[vars.replayId]"
                is="#[MunitTools::equalTo(2126833)]"
                message="AMQP replay ID was not preserved."/>

        </munit:validation>

    </munit:test>

</mule>