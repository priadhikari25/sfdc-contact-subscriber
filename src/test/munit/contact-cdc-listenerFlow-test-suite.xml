    <munit:test
        name="testContactNotFound"
        description="Validate empty Contact values when Salesforce returns no Contact">

        <munit:behavior>

            <munit-tools:mock-when processor="salesforce:query">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="#['Retrieve Salesforce Contact Details']"/>
                </munit-tools:with-attributes>

                <munit-tools:then-return>
                    <munit-tools:payload
                        value="#[[]]"
                        mediaType="application/java"/>
                </munit-tools:then-return>

            </munit-tools:mock-when>

        </munit:behavior>

        <munit:execution>

            <munit:set-event doc:name="Set Contact Not Found Context">

                <munit:payload
                    value="#[null]"
                    mediaType="application/java"/>

                <munit:variables>

                    <munit:variable
                        key="correlationId"
                        value="#['TEST-CORRELATION-NOT-FOUND']"
                        mediaType="application/java"/>

                    <munit:variable
                        key="contactId"
                        value="#['003NOTFOUND']"
                        mediaType="application/java"/>

                    <munit:variable
                        key="replayId"
                        value="#[2126901]"
                        mediaType="application/java"/>

