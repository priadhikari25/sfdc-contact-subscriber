<?xml version="1.0" encoding="UTF-8"?>

<settings
    xmlns="http://maven.apache.org/SETTINGS/1.2.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://maven.apache.org/SETTINGS/1.2.0
        https://maven.apache.org/xsd/settings-1.2.0.xsd">

    <servers>

        <server>
            <id>anypoint-exchange-v3</id>
            <username>~~~Client~~~</username>

            <password>
                ${env.ANYPOINT_CLIENT_ID}~?~${env.ANYPOINT_CLIENT_SECRET}
            </password>
        </server>

    </servers>

    <profiles>

        <profile>
            <id>mulesoft-repositories</id>

            <repositories>

                <repository>
                    <id>anypoint-exchange-v3</id>
                    <name>Anypoint Exchange</name>

                    <url>
                        https://maven.anypoint.mulesoft.com/api/v3/maven
                    </url>

                    <layout>default</layout>

                    <releases>
                        <enabled>true</enabled>
                    </releases>

                    <snapshots>
                        <enabled>true</enabled>
                    </snapshots>
                </repository>

                <repository>
                    <id>mulesoft-releases</id>

                    <name>
                        MuleSoft Releases Repository
                    </name>

                    <url>
                        https://repository.mulesoft.org/nexus/repository/releases/
                    </url>

                    <layout>default</layout>

                    <releases>
                        <enabled>true</enabled>
                    </releases>

                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                </repository>

            </repositories>

            <pluginRepositories>

                <pluginRepository>
                    <id>mulesoft-releases</id>

                    <name>
                        MuleSoft Releases Repository
                    </name>

                    <url>
                        https://repository.mulesoft.org/nexus/repository/releases/
                    </url>

                    <layout>default</layout>

                    <releases>
                        <enabled>true</enabled>
                    </releases>

                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                </pluginRepository>

            </pluginRepositories>

        </profile>

    </profiles>

    <activeProfiles>
        <activeProfile>
            mulesoft-repositories
        </activeProfile>
    </activeProfiles>

</settings>
